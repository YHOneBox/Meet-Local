{
  "name": "meetlocal",
  "version": "1.1.0",
  "private": true,
  "description": "Host a voice, video, and screen-sharing meeting from your own computer.",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "icon": "node scripts/generate-icon.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run icon && npm run typecheck && npm run build:renderer && npm run build:electron",
    "dev": "npm run build:electron && cross-env MEETLOCAL_DEV=1 electron .",
    "start": "electron .",
    "dist": "npm run build && electron-builder --publish never --config electron-builder.yml",
    "dist:win": "npm run build && electron-builder --win portable --publish never --config electron-builder.yml",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "express": "^4.21.2",
    "selfsigned": "^2.4.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@fontsource/fraunces": "^5.2.5",
    "@fontsource/outfit": "^5.2.5",
    "@playwright/test": "^1.55.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.1",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
